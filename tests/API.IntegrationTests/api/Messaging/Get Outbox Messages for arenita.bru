meta {
  name: Get Outbox Messages for arenita
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/messages?container=outbox
  body: none
  auth: inherit
}

params:query {
  container: outbox
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "container": "outbox"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
